{
  "name": "single-player-jubensha-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vite-node --config vitest.config.ts scripts/runtime.ts dev",
    "runtime:check": "vite-node --config vitest.config.ts scripts/runtime.ts check",
    "db:init": "vite-node --config vitest.config.ts scripts/runtime.ts init",
    "preset:install": "vite-node --config vitest.config.ts scripts/runtime.ts install",
    "release:audit": "node scripts/audit-public.mjs",
    "release:source": "node scripts/export-public.mjs",
    "preset:export": "vite-node --config vitest.config.ts scripts/export-long-night-preset.ts",
    "access:local": "vite-node --config vitest.config.ts benchmarks/local-access.ts",
    "build": "vite-node --config vitest.config.ts scripts/runtime.ts build",
    "start": "vite-node --config vitest.config.ts scripts/runtime.ts start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@next/env": "15.5.28",
    "@prisma/client": "6.19.3",
    "next": "15.5.28",
    "openai": "6.42.0",
    "pdf-lib": "^1.17.1",
    "prisma": "6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0",
    "vite-node": "3.2.4"
  }
}
