# 使用方法：复制本文件为 .env，再编辑 .env；不要把真实密钥写进本示例。
# 苹果电脑：cp .env.example .env
# Windows 电脑的 PowerShell：Copy-Item .env.example .env
#
# 推荐方案：千问付费主模型 + 百炼赠送额度的 DeepSeek 辅助模型，不是全部默认走百炼。
# 1. AI 玩家、DM及其规划/生成/审核使用千问按量付费 API，主链调用量大，不靠有限赠额撑整局。
# 2. Semantic Observer 只辅助 DM 判断公开信息，作者试玩中用量较少，单独利用百炼 DeepSeek 赠额省开支。
# 3. 按此示例主要填写 QWEN_API_KEY 和 BAILIAN_API_KEY，两把密钥分别来自各自平台，不要混用。
# 4. 作者《长夜》完整局主模型经验用量约 6–10M Token（600–1000万，输入与输出累计）。
#    这是整局预算参考，不是单次请求长度或固定费用；讨论、重试、剧本和开关都会影响用量。
# 5. 百炼赠额受账号、地域、模型、有效期及余额限制，不保证人人或每局免费。
#    用完或过期可能付费；请检查控制台，按需开启“免费额度用完即停”。
# 6. 模型须支持关闭思考、Chat Completions与JSON对象输出；保留 LLM_THINKING_MODE="disabled"。
# 7. BASE_URL 是 API 基础地址，不是聊天网页，也不要追加 /chat/completions。
# 8. 填完运行 npm run runtime:check；只核对配置，不调用模型或验证Key有效性。
# 更完整的费用、模型要求与替代API填法见 README.md；高级参数先保持默认。

# ========= 一、个人数据库：一般不用改 =========
DATABASE_URL="file:../storage/app.db"

# ========= 二、游戏使用的两组模型 =========
# 第一组：千问按量付费Qwen，供AI玩家、DM及角色规划/生成/审核使用。
# bailian 是现有适配器标签，不表示全部发往百炼；Qwen实际通过第三部分QWEN_BASE_URL发往千问。
# 按推荐方案保留此值，不要改成中文平台名。
RUNTIME_LLM_PROVIDER="bailian"
# 保留已试玩的模型ID；换模型须确认非思考、JSON输出与长上下文能力。
RUNTIME_LLM_MODEL="qwen3.8-flash"
# 推荐方案这两项留空，地址和密钥统一填第三部分QWEN_*。
# 如改用其他兼容API，设置 PROVIDER=compatible，并显式填写这里的地址、密钥及模型名。
RUNTIME_LLM_BASE_URL=""
RUNTIME_LLM_API_KEY=""

# 第二组：百炼DeepSeek，仅作Semantic Observer，判断公开发言是否回答问题/满足条件。
# 作者试玩中这部分用量较少，赠额够用；不代表每个账号都有同样额度。
# 这里地址/密钥留空会使用第三部分BAILIAN_*，不会借用千问的密钥。
DM_SEMANTIC_OBSERVER_PROVIDER="bailian"
DM_SEMANTIC_OBSERVER_MODEL="deepseek-v4.1-flash"
DM_SEMANTIC_OBSERVER_BASE_URL=""
DM_SEMANTIC_OBSERVER_API_KEY=""

# ========= 三、填写两个平台的密钥：推荐方案必填 =========
# 百炼Key：推荐只供Observer，确认该DeepSeek模型的权限、剩余额度及有效期。
# 地址和密钥须属于同一地域与服务；这里是百炼兼容接口地址。
BAILIAN_API_KEY=""
BAILIAN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# 千问Key：填写千问AI平台“按量付费API”的Key，与下面地址配套使用。
# 不要混用百炼Key或订阅套餐专属Key；此示例不是订阅套餐地址。
# Qwen通过此地址分流，DeepSeek Observer仍走百炼。
QWEN_BASE_URL="https://maas.qianwenaiapi.com/compatible-mode/v1"
QWEN_API_KEY=""
# Observer既有故障切换可能使用 deepseek-v4.1-flash-1017，也检查它的权限、额度和收费。

# ========= 四、以下为高级运行参数：初次使用无需修改 =========
# 保持已验证的运行基线，关闭深度思考；不要为了“更聪明”而开启，否则可能增加延迟和Token。
# 推荐路由发送 enable_thinking:false；结构化任务使用 response_format 的 json_object 模式。
LLM_THINKING_MODE="disabled"
# 分享草稿预生成是可选功能，默认关闭。
SHARE_DRAFT_ENABLED="false"
# 普通模型请求超时，单位毫秒；90000 表示 90 秒。
LLM_TIMEOUT_MS="90000"

# DM 辅助判断的超时、输出上限、最短调用间隔和输入字符保护。
# 6000 毫秒表示 6 秒，3000 毫秒表示 3 秒。
DM_SEMANTIC_OBSERVER_TIMEOUT_MS="6000"
DM_SEMANTIC_OBSERVER_MAX_TOKENS="2400"
DM_SEMANTIC_OBSERVER_MIN_INTERVAL_MS="3000"
DM_SEMANTIC_OBSERVER_MAX_INPUT_CHARS="60000"

# 公共信息板后台请求超时，30000 毫秒表示 30 秒。
STORY_BOARD_TIMEOUT_MS="30000"
# 允许 DM 对可灵活表达的参考台词生成话术，固定台词仍受原流程约束。
DM_REFERENCE_WORDING_ENABLED="true"
# 讨论收束前的安静缓冲，45000 毫秒表示 45 秒；不替代必须分享和待回答问题。
DISCUSSION_QUIET_MS="45000"

# 单次请求的自动上下文压缩，不修改数据库中的私本或长期记忆。
# false 表示关闭；最终本地字符硬保护仍为 60000。
AUTO_CONTEXT_COMPRESSION_ENABLED="true"
AUTO_CONTEXT_TRIGGER_CHARS="54000"
AUTO_CONTEXT_TARGET_CHARS="52000"
# 应用的单次模型上下文预算，包括输入估计、输出及安全预留，不等于平台承诺容量。
# 这与整局累计6–10M不同，更换模型须核对实际容量。
AUTO_CONTEXT_MODEL_WINDOW_TOKENS="65536"

# ========= 五、上传剧本解析：实验功能，只玩资源包时不用配置 =========
# 解析使用百炼/千问路由，费用额外计算，不含在完整游戏6–10M经验参考中。
BAILIAN_MANUAL_PLANNER_MODEL="qwen3.8-flash"
BAILIAN_MANUAL_EXTRACTOR_MODEL="qwen3.8-flash"
BAILIAN_MANUAL_REPAIR_MODEL="qwen3.8-flash"
BAILIAN_MANUAL_PLANNER_TIMEOUT_MS="180000"
BAILIAN_MANUAL_PLANNER_MAX_TOKENS="6000"
BAILIAN_MANUAL_EXTRACTOR_TIMEOUT_MS="180000"
BAILIAN_MANUAL_EXTRACTOR_MAX_TOKENS="10000"
BAILIAN_MANUAL_EXTRACTOR_ENABLED="false"

# ========= 六、旧版兼容设置：新用户不用填 =========
# 请使用上方两组明确配置，不要只填写这三个旧变量。
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL=""

# ========= 七、本机访问凭证：一般不用手填 =========
# 留空时会在 storage/local-access 下自动生成本机凭证。
# 如自行设置，使用至少 32 字符的高随机性字符串；不要使用 NEXT_PUBLIC 前缀。
# LOCAL_DEVELOPER_TOKEN=
# LOCAL_ACCESS_SIGNING_KEY=
# LOCAL_ACCESS_STATE_DIR=
